# ══════════════════════════════════════════════
# .gitignore — Placement Prep Tracker
# ══════════════════════════════════════════════

# ── Secrets / Environment ──────────────────────
.env
.env.local
.env.prod
.env.staging
# Keep the example template committed
!.env.example

# ── Maven Build Output ─────────────────────────
backend/target/
!backend/.mvn/wrapper/maven-wrapper.jar
!backend/**/src/main/**/target/
!backend/**/src/test/**/target/

# ── Java ───────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ── IDE — IntelliJ IDEA ────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# ── IDE — VS Code ─────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── IDE — Eclipse ─────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/

# ── OS ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs ───────────────────────────────────────
*.log
logs/
spring-shell.log

# ── Node (if frontend tooling added later) ─────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/

# ── Misc ───────────────────────────────────────
*.tmp
*.bak
*.swp
*.swo
*~
